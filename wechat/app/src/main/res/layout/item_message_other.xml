<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12">

    <TextView
        android:id="@+id/tv_time"
        style="@style/WeChatListTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_12"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/message_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/avatar_chat"
            android:layout_height="@dimen/avatar_chat"
            android:layout_marginEnd="@dimen/space_8"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="6dp"
            android:layout_height="11dp"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_bubble_tail_left" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:background="@drawable/bg_bubble_other"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3sp"
            android:maxWidth="@dimen/bubble_max_width"
            android:paddingStart="@dimen/space_10"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_10"
            android:paddingBottom="@dimen/space_8"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_primary" />

    </LinearLayout>

</LinearLayout>
