<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/toolbar_height"
            android:layout_height="@dimen/toolbar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tab_contacts"
            android:padding="@dimen/space_12"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="@dimen/toolbar_height"
            android:layout_height="@dimen/toolbar_height"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_more"
            android:padding="@dimen/space_10"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/text_primary" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 资料区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="@dimen/avatar_large"
                    android:layout_height="@dimen/avatar_large"
                    android:contentDescription="@string/tab_contacts"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/WeChatListPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_wechat_id"
                        style="@style/WeChatListSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6" />

                    <TextView
                        android:id="@+id/tv_region"
                        style="@style/WeChatListSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4" />

                </LinearLayout>

            </LinearLayout>

            <!-- 备注 / 朋友圈 / 更多信息 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- 发消息 / 语音通话 / 视频通话 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_send_message"
                    style="@style/WeChatListPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/common_item_height"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/contact_send_message"
                    android:textColor="@color/wechat_green" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tv_voice_call"
                    style="@style/WeChatListPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/common_item_height"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/contact_voice_call" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tv_video_call"
                    style="@style/WeChatListPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/common_item_height"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/contact_video_call" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
