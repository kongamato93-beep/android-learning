<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全策略：默认禁止明文（HTTP），只对本地的中转服务放行。

    为什么需要这个文件：
      Android 9（API 28）起默认不允许明文流量。本机跑的 server/proxy.mjs 是 HTTP，
      不单独放行的话 App 会直接报 CleartextTrafficPermitted 错误。

    为什么不用「全局放行」：
      一旦全局开明文，别的所有 HTTP 请求（第三方 SDK、WebView 里的资源）也都不设防了。
      这里用 domain-config 做最小授权 —— 只有这三个本地地址能走明文，其余照旧禁止。

    想让真机连同一 WiFi 下的电脑：
      在下面 <domain-config> 里加一行 <domain>你的局域网IP</domain>，比如 192.168.1.20。
      这一修改只影响明文白名单，不会削弱 HTTPS 的安全性。
-->
<network-security-config>

    <!-- 全局基线：禁止明文。HTTPS 不受任何影响 -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- 本地中转服务的明文白名单 -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android 模拟器访问宿主机的固定地址 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 本机回环：adb reverse 或桌面端调试时会用到 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

</network-security-config>
