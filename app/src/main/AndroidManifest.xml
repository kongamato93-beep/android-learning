<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        联网权限：两条 AI 通道（本机中转服务、直连智谱）都要用。
        明文策略由 res/xml/network_security_config.xml 单独控制：
        默认全禁，只对本地中转地址放行，这里不要改成 true。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".WeChatApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.WeChat"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- 启动页：后台完成数据库初始化后才拉起 MainActivity -->
        <activity
            android:name=".ui.launch.LauncherActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WeChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.contact.ContactDetailActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.me.SettingsActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>
