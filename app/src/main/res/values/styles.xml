<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WeChat" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/tab_bg</item>
        <item name="colorAccent">@color/wechat_green</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 顶部标题栏文字 -->
    <style name="WeChatToolbarTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 列表主标题 -->
    <style name="WeChatListPrimary">
        <item name="android:textSize">@dimen/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 列表副标题 -->
    <style name="WeChatListSecondary">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 时间 / 角标文字 -->
    <style name="WeChatListTime">
        <item name="android:textSize">@dimen/text_hint</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="WeChatTabText">
        <item name="android:textSize">@dimen/text_tab</item>
        <item name="android:textColor">@color/tab_text_color</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
