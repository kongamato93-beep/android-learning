<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/contact_item_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/avatar_contact"
            android:layout_height="@dimen/avatar_contact"
            android:contentDescription="@string/tab_contacts"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_name"
            style="@style/WeChatListPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12" />

    </LinearLayout>

    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_marginStart="@dimen/divider_start"
        android:background="@color/divider" />

</LinearLayout>
